            <div class="bg-emerald-50 p-6 sm:p-10 rounded-xl shadow-2xl text-gray-800">
                <form onsubmit="handleVolunteerSignup(event)" class="space-y-6">
                    <div>
                        <label for="volunteer-name" class="block text-left text-sm font-medium text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="volunteer-name" name="volunteer-name" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-emerald-500 focus:ring-emerald-500 transition duration-150 shadow-sm" placeholder="Your Name">
                    </div>
                    <div>
                        <label for="volunteer-contact" class="block text-left text-sm font-medium text-gray-700 mb-2">Email or Phone Number</label>
                        <input type="text" id="volunteer-contact" name="volunteer-contact" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-emerald-500 focus:ring-emerald-500 transition duration-150 shadow-sm" placeholder="e.g., you@example.com or +91 99999 00000">
                    </div>
                    <div>
                        <label for="volunteer-message" class="block text-left text-sm font-medium text-gray-700 mb-2">Why do you want to volunteer?</label>
                        <textarea id="volunteer-message" name="volunteer-message" rows="3"
                                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:border-emerald-500 focus:ring-emerald-500 transition duration-150 shadow-sm" placeholder="Tell us about your availability and interest."></textarea>
                    </div>
                    
                    <button type="submit" class="w-full cta-button bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounde
