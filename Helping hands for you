    <!-- Volunteer CTA Section -->
    <section id="volunteer" class="py-16 md:py-24 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="section-heading text-3xl font-bold text-gray-900 mb-4">Join Our Ground Team</h2>
