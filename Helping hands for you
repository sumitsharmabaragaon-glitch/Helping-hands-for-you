<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Compassionate Care: Feeding & Treating Street Animals</title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Using Inter font as required */
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f7f7f7;
        }
        .hero-bg {
            background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.5)), url('https://placehold.co/1200x600/10b981/ffffff?text=Animals+In+Need');
            background-size: cover;
            background-position: center;
        }
        .cta-button {
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.6);
        }
        .section-heading {
            position: relative;
            display: inline-block;
        }
        .section-heading::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 50%;
            height: 3px;
            background-color: #10b981; /* Emerald */
            border-radius: 9999px;
        }
    </style>
    <script>
        // Use a descriptive placeholder image URL generator
        function getPlaceholderUrl(text, width = 600, height = 400, bg = '4b5563', fg = 'ffffff') {
            return `https://placehold.co/${width}x${height}/${bg}/${fg}?text=${text.replace(/\s/g, '+')}`;
        }

        // --- Firebase/Firestore Setup (Required for persistence) ---
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        let db;
        let auth;
        let userId = 'anonymous';
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'default-app-id';

        window.onload = async function() {
            try {
                // Parse the Firebase config from the global variable
                const firebaseConfig = JSON.parse(typeof __firebase_config !== 'undefined' ? __firebase_config : '{}');
                
                if (Object.keys(firebaseConfig).length > 0) {
                    const app = initializeApp(firebaseConfig);
                    db = getFirestore(app);
                    auth = getAuth(app);

                    // Authentication using the provided custom token or falling back to anonymous
                    const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

                    if (initialAuthToken) {
                        await signInWithCustomToken(auth, initialAuthToken);
                    } else {
                        await signInAnonymously(auth);
                    }
                    
                    userId = auth.currentUser?.uid || crypto.randomUUID();
                    console.log("Firebase initialized. User ID:", userId);
                    document.getElementById('db-status').textContent = 'Database Connected';
                    document.getElementById('db-status').classList.remove('text-red-500');
                    document.getElementById('db-status').classList.add('text-green-500');

                } else {
                    console.error("Firebase config not found.");
                    document.getElementById('db-status').textContent = 'Database Not Configured';
                    document.getElementById('db-status').classList.remove('text-green-500');
                    document.getElementById('db-status').classList.add('text-red-500');
                }

            } catch (error) {
                console.error("Error during Firebase initialization or sign-in:", error);
                document.getElementById('db-status').textContent = 'Database Error';
                document.getElementById('db-status').classList.remove('text-green-500');
                document.getElementById('db-status').classList.add('text-red-500');
            }
        };

        // Function to handle simulated donation
        async function handleDonate(event) {
            event.preventDefault();
            const amountInput = document.getElementById('donation-amount');
            const amount = parseFloat(amountInput.value);

            const messageBox = document.getElementById('donation-message-box');

            if (isNaN(amount) || amount <= 0) {
                messageBox.textContent = "Please enter a valid donation amount.";
                messageBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                messageBox.classList.add('bg-red-100', 'text-red-800', 'block');
                return;
            }

            if (!db) {
                messageBox.textContent = "Error: Database is not connected. Cannot process simulated donation.";
                messageBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                messageBox.classList.add('bg-red-100', 'text-red-800', 'block');
                console.error("Firestore database instance is not available.");
                return;
            }

            try {
                // Log the simulated donation to the public Firestore collection
                const donationsRef = collection(db, `artifacts/${appId}/public/data/donations`);
                
                await addDoc(donationsRef, {
                    amount: amount,
                    donorId: userId,
                    timestamp: serverTimestamp(),
                    status: 'Simulated Success',
                    item: 'Animal Welfare Fund'
                });

                messageBox.textContent = `Thank you! Your simulated donation of $${amount.toFixed(2)} has been successfully logged!`;
                messageBox.classList.remove('hidden', 'bg-red-100', 'text-red-800');
                messageBox.classList.add('bg-green-100', 'text-green-800', 'block');
                amountInput.value = ''; // Clear input

            } catch (error) {
                console.error("Error logging simulated donation:", error);
                messageBox.textContent = "An error occurred while logging the donation. Please try again.";
                messageBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                messageBox.classList.add('bg-red-100', 'text-red-800', 'block');
            }
        }
        
        // Function to handle volunteer sign-up
        async function handleVolunteerSignup(event) {
            event.preventDefault();
            
            const form = event.target;
            const name = form['volunteer-name'].value;
            const contact = form['volunteer-contact'].value;
            const message = form['volunteer-message'].value;

            const messageBox = document.getElementById('volunteer-message-box');
            
            if (!name || !contact) {
                messageBox.textContent = "Please fill in your name and contact details.";
                messageBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                messageBox.classList.add('bg-red-100', 'text-red-800', 'block');
                return;
            }

            if (!db) {
                messageBox.textContent = "Error: Database is not connected. Cannot process volunteer sign-up.";
                messageBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                messageBox.classList.add('bg-red-100', 'text-red-800', 'block');
                console.error("Firestore database instance is not available.");
                return;
            }

            try {
                // Log the volunteer interest to the public Firestore collection
                const volunteersRef = collection(db, `artifacts/${appId}/public/data/volunteers`);
                
                await addDoc(volunteersRef, {
                    name: name,
                    contact: contact,
                    message: message,
                    userId: userId,
                    timestamp: serverTimestamp(),
                    status: 'New Interest'
                });

                messageBox.textContent = `Thank you, ${name}! Your interest in volunteering has been recorded. We will reach out soon!`;
                messageBox.classList.remove('hidden', 'bg-red-100', 'text-red-800');
                messageBox.classList.add('bg-green-100', 'text-green-800', 'block');
                form.reset(); // Clear form

            } catch (error) {
                console.error("Error logging volunteer sign-up:", error);
                messageBox.textContent = "An error occurred while logging your interest. Please try again.";
                messageBox.classList.remove('hidden', 'bg-green-100', 'text-green-800');
                messageBox.classList.add('bg-red-100', 'text-red-800', 'block');
            }
        }

        // Smooth scrolling for navigation links
        function scrollToSection(id) {
            const element = document.getElementById(id);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth' });
            }
        }
    </script>
</head>
<body class="bg-gray-50 text-gray-800 antialiased">

